      <field name="website_meta_description">Your Daily Dose Pharmacy: pharmacy care, wellness, and everyday essentials with a personal touch.</field>
      <field name="arch" type="xml">
        <t t-name="ydd_pharmacy_website.page_home">
          <t t-call="website.layout">
            <div id="wrap" class="ydd-content ydd-home oe_structure"><section class="banner-slider" aria-roledescription="carousel" aria-label="Discover Your Daily Dose" data-snippet="s_text_block" data-name="Your Daily Dose Home"><div class="banner-slide active" role="group" aria-roledescription="slide" aria-label="1 of 3"><img src="/ydd_pharmacy_website/static/src/img/family.jpg" alt="Family enjoying time together outdoors" width="2200" height="1467" fetchpriority="high" class="img-fluid" decoding="async"/><div class="banner-shade"/><div class="wrap banner-content"><span class="eyebrow">HEALTH. WELLNESS. EVERY DAY.</span><h1>Your daily dose<br/>of <em>better living.</em></h1><p>Pharmacy care, wellness and everyday essentials.<br/>Right here in Port of Spain.</p><div class="hero-buttons"><a class="button " href="/shop">Shop everyday essentials<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a><a href="/visit-us" class="button secondary">Visit &amp; contact</a></div></div></div><div class="banner-slide pharmacy-slide" role="group" aria-roledescription="slide" aria-label="2 of 3" aria-hidden="true" inert=""><img src="/ydd_pharmacy_website/static/src/img/pharmacist.jpg" alt="A pharmacy professional holding a notebook in a pharmacy" width="1600" height="2400" class="img-fluid" decoding="async"/><div class="banner-shade"/><div class="wrap banner-content"><span class="eyebrow">A LITTLE CARE GOES A LONG WAY</span><h2>Here for your health.<br/><em>Here for you.</em></h2><p>Prescription questions. Everyday essentials.<br/>A helpful place to start.</p><div class="hero-buttons"><a class="button " href="/pharmacy-services">Explore pharmacy care<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a><a href="/visit-us" class="button secondary">Visit &amp; contact</a></div></div></div><div class="banner-slide wellness-slide" role="group" aria-roledescription="slide" aria-label="3 of 3" aria-hidden="true" inert="inert"><img src="/ydd_pharmacy_website/static/src/img/wellness.jpg" alt="Woman practising yoga outdoors" width="1400" height="2100" decoding="async"/><div class="banner-shade"/><div class="wrap banner-content"><span class="eyebrow">MAKE TIME FOR YOURSELF</span><h2>A little balance.<br/><em>Every single day.</em></h2><p>Personal care and everyday essentials,<br/>all in one place.</p><div class="hero-buttons"><a class="button" href="/shop">Find your essentials <span aria-hidden="true">→</span></a><a href="/visit-us" class="button secondary">Visit &amp; contact</a></div></div></div><div class="banner-controls"><button class="slide-prev" aria-label="Previous banner" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button><div class="slide-dots"><button class="selected" aria-label="Show banner 1" aria-pressed="true" type="button"/><button aria-label="Show banner 2" aria-pressed="false" type="button"/><button aria-label="Show banner 3" aria-pressed="false" type="button"/></div><button class="slide-next" aria-label="Next banner" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button><button class="slide-pause" aria-label="Pause banners" type="button">Ⅱ</button></div></section>
<section class="care-links" aria-label="Care at Your Daily Dose" data-snippet="s_text_block" data-name="Your Daily Dose Home"><div class="wrap"><a href="/pharmacy-services#prescription"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 15 6-6M5.5 18.5a5 5 0 0 1 0-7l6-6a5 5 0 0 1 7 7l-6 6a5 5 0 0 1-7 0Z"/></svg> Prescription care</a><a href="/pharmacy-services#advice"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5H4l-2 2v-9.5A8.5 8.5 0 1 1 21 11.5Z"/><path d="M7 10h9m-9 4h6"/></svg> Pharmacy guidance</a><a href="/wellness"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 3C9 1 2 7 5 15c8 4 15-2 15-12Z"/><path d="m3 21 12-13"/></svg> Everyday wellness</a></div></section>
<t t-call="ydd_pharmacy_website.category_circles"/><t t-call="ydd_pharmacy_website.promo_banners"/><t t-call="ydd_pharmacy_website.featured_products"/><section class="ydd-about-strip" data-snippet="s_text_block" data-name="About Us">
  <div class="wrap split"><div class="rounded-photo"><img src="/ydd_pharmacy_website/static/src/img/pharmacist.jpg" width="1600" height="2400" alt="Pharmacy professional in a pharmacy" loading="lazy" decoding="async"/></div>
  <div class="split-copy"><span class="eyebrow">YOUR NEIGHBOURHOOD PHARMACY</span><h2>A personal touch.<br/><em>For the whole family.</em></h2><p>Everyday essentials, thoughtful pharmacy care and a warm welcome. Find the products you need and a helpful place to start with your questions.</p><a href="/about-us" class="button">Get to know us <span aria-hidden="true">→</span></a></div></div>
</section><section class="cta-section wrap reveal" data-snippet="s_text_block" data-name="Your Daily Dose Home"><div><span class="eyebrow">LET’S TAKE CARE OF YOU</span><h2>Your next step to<br/>feeling supported.</h2><p>Have a question? Start a conversation with Your Daily Dose.</p></div><a class="button " href="/visit-us">Visit &amp; contact<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a></section></div>
          </t>
        </t>
      </field>
